<Window x:Class="Balsoft.Hive.Installer.Windows.Wizard.WizardWindow" x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="720" Height="540" MinWidth="640" MinHeight="480"
        WindowStartupLocation="CenterScreen" ResizeMode="CanMinimize"
        Background="#EEF1F5" FontFamily="Segoe UI" FontSize="13"
        Closing="OnClosing">
    <Window.Resources>
        <SolidColorBrush x:Key="Surface" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="BorderSoft" Color="#E4E8EE"/>
        <SolidColorBrush x:Key="BorderStrong" Color="#D3D9E1"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#0F172A"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#475569"/>
        <SolidColorBrush x:Key="Danger" Color="#B91C1C"/>
        <SolidColorBrush x:Key="Accent" Color="#2563EB"/>
        <LinearGradientBrush x:Key="HeaderBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#0C1424" Offset="0"/>
            <GradientStop Color="#15213A" Offset="1"/>
        </LinearGradientBrush>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="PageTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,10,0,4"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderStrong}"/>
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderStrong}"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="MinWidth" Value="92"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderStrong}"/>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- Header -->
        <Border DockPanel.Dock="Top" Background="{StaticResource HeaderBrush}" Padding="22,14">
            <DockPanel>
                <Image x:Name="HeaderLogo" DockPanel.Dock="Left" Width="44" Height="44" Margin="0,0,14,0"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="HeaderTitle" Foreground="White" FontSize="17" FontWeight="SemiBold"/>
                    <TextBlock x:Name="HeaderSubtitle" Foreground="#AAB4C3" FontSize="12" Margin="0,2,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Footer -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource Surface}" BorderBrush="{StaticResource BorderSoft}"
                BorderThickness="0,1,0,0" Padding="22,12">
            <DockPanel>
                <TextBlock x:Name="FooterNote" DockPanel.Dock="Left" Style="{StaticResource Hint}" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="BackButton" Content="Back" Click="OnBack"/>
                    <Button x:Name="NextButton" Content="Next" Click="OnNext" IsDefault="True"
                            Foreground="White" FontWeight="SemiBold"/>
                    <Button x:Name="CancelButton" Content="Cancel" Click="OnCancel" IsCancel="True"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Pages -->
        <Grid Margin="26,20,26,16">

            <Grid x:Name="WelcomePage">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="WelcomeImageColumn" Width="150"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Image x:Name="WelcomeImage" Stretch="UniformToFill" VerticalAlignment="Top" Height="300"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
                <StackPanel Grid.Column="1" Margin="22,0,0,0">
                    <TextBlock x:Name="WelcomeTitle" Style="{StaticResource PageTitle}"/>
                    <TextBlock x:Name="WelcomeText" Style="{StaticResource Hint}" FontSize="13"/>
                    <TextBlock x:Name="WelcomeDescription" Style="{StaticResource Hint}" Margin="0,14,0,0"/>
                </StackPanel>
            </Grid>

            <DockPanel x:Name="LicensePage" Visibility="Collapsed">
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource PageTitle}" Text="Licence agreement"/>
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource Hint}" Margin="0,0,0,8"
                           Text="Please read the licence agreement. You must accept it to continue."/>
                <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                    <RadioButton x:Name="AcceptLicense" Content="I accept the agreement" Checked="OnLicenseChoice" Margin="0,0,0,4"/>
                    <RadioButton x:Name="DeclineLicense" Content="I do not accept the agreement" IsChecked="True" Checked="OnLicenseChoice"/>
                </StackPanel>
                <TextBox x:Name="LicenseText" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                         FontSize="12" Background="{StaticResource Surface}"/>
            </DockPanel>

            <StackPanel x:Name="FolderPage" Visibility="Collapsed">
                <TextBlock Style="{StaticResource PageTitle}" Text="Install folder"/>
                <TextBlock x:Name="FolderHint" Style="{StaticResource Hint}"/>
                <TextBlock Style="{StaticResource Label}" Text="Folder"/>
                <DockPanel>
                    <Button x:Name="BrowseButton" DockPanel.Dock="Right" Content="Browse..." Click="OnBrowse"/>
                    <TextBox x:Name="FolderBox"/>
                </DockPanel>
            </StackPanel>

            <StackPanel x:Name="AccountPage" Visibility="Collapsed">
                <TextBlock Style="{StaticResource PageTitle}" Text="Service account"/>
                <TextBlock x:Name="AccountHint" Style="{StaticResource Hint}"/>
                <TextBlock Style="{StaticResource Label}" Text="Service account (optional, DOMAIN\user)"/>
                <TextBox x:Name="AccountBox"/>
                <TextBlock Style="{StaticResource Label}" Text="Password"/>
                <PasswordBox x:Name="PasswordBox"/>
                <TextBlock x:Name="AccountError" Foreground="{StaticResource Danger}" Margin="0,10,0,0" Visibility="Collapsed"/>
            </StackPanel>

            <StackPanel x:Name="OptionsPage" Visibility="Collapsed">
                <TextBlock Style="{StaticResource PageTitle}" Text="Shortcuts"/>
                <TextBlock Style="{StaticResource Hint}" Text="Shortcuts are always added to the Start menu."/>
                <CheckBox x:Name="DesktopBox" Content="Create desktop shortcuts" Margin="0,14,0,0"/>
            </StackPanel>

            <StackPanel x:Name="ReadyPage" Visibility="Collapsed">
                <TextBlock Style="{StaticResource PageTitle}" Text="Ready to install"/>
                <TextBlock Style="{StaticResource Hint}" Text="Setup is ready to install with these settings:"/>
                <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource BorderSoft}" BorderThickness="1"
                        CornerRadius="6" Padding="14" Margin="0,12,0,0">
                    <TextBlock x:Name="ReadySummary" FontSize="12.5" LineHeight="20"/>
                </Border>
            </StackPanel>

            <DockPanel x:Name="ProgressPage" Visibility="Collapsed">
                <TextBlock x:Name="ProgressTitle" DockPanel.Dock="Top" Style="{StaticResource PageTitle}"/>
                <TextBlock x:Name="ProgressStatus" DockPanel.Dock="Top" Style="{StaticResource Hint}" Margin="0,0,0,8"/>
                <ProgressBar x:Name="ProgressBar" DockPanel.Dock="Top" Height="8" Minimum="0" Maximum="100"
                             Background="{StaticResource BorderSoft}" BorderThickness="0"/>
                <TextBox x:Name="LogBox" Margin="0,14,0,0" IsReadOnly="True" FontFamily="Cascadia Mono, Consolas" FontSize="11"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                         Background="#0D1117" Foreground="#C9D1D9" BorderThickness="0" Padding="8"/>
            </DockPanel>

            <Grid x:Name="FinishPage" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="FinishImageColumn" Width="150"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Image x:Name="FinishImage" Stretch="UniformToFill" VerticalAlignment="Top" Height="300"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
                <StackPanel Grid.Column="1" Margin="22,0,0,0">
                    <TextBlock x:Name="FinishTitle" Style="{StaticResource PageTitle}"/>
                    <TextBlock x:Name="FinishText" Style="{StaticResource Hint}" FontSize="13"/>
                    <CheckBox x:Name="LaunchBox" IsChecked="True" Margin="0,16,0,0"/>
                    <TextBlock x:Name="FinishLog" Style="{StaticResource Hint}" Margin="0,16,0,0"/>
                </StackPanel>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
