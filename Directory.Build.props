<Project>

  <PropertyGroup>
    <VersionPrefix>2.0.1</VersionPrefix>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);CA1716;CA1720;CA1002;CA2227;CA1056;CA1054;CA1034;CA1305</NoWarn>
    <!-- CA1031: an installer catches broadly on purpose, logs the reason and rolls back or carries
         on; a crash would leave a half-installed product. -->
    <NoWarn>$(NoWarn);CA1031</NoWarn>

    <Authors>Ertugrul Balveren</Authors>
    <Company>Balsoft GmbH</Company>
    <Copyright>Copyright (c) Balsoft GmbH</Copyright>
    <Product>Balsoft.Hive.Installer.Windows</Product>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/balsoft-gmbh/Balsoft.Hive.Installer.Windows</PackageProjectUrl>
    <RepositoryUrl>https://github.com/balsoft-gmbh/Balsoft.Hive.Installer.Windows</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageTags>installer;setup;windows;wpf;windows-service;uninstaller;deployment</PackageTags>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>

</Project>
